{
  "title": "Playhead \u00e2\u20ac\u201d Surge Overview",
  "uid": "playhead-surge",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Read latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=~\"/v1/playback/(resume.*|continue-watching)\"}[$__rate_interval])) by (le, uri))",
          "legendFormat": "p50 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/v1/playback/(resume.*|continue-watching)\"}[$__rate_interval])) by (le, uri))",
          "legendFormat": "p95 {{uri}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=~\"/v1/playback/(resume.*|continue-watching)\"}[$__rate_interval])) by (le, uri))",
          "legendFormat": "p99 {{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Write latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=\"/v1/playback/heartbeat\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/v1/playback/heartbeat\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/v1/playback/heartbeat\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request rate by status",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"200|202\"}[$__rate_interval]))",
          "legendFormat": "served (200/202)"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=\"429\"}[$__rate_interval]))",
          "legendFormat": "429 shed"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx error"
        }
      ]
    },
    {
      "id": 4,
      "title": "Admission control \u2014 shed rate by tier (app layer)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(admission_shed_total[$__rate_interval])) by (tier)",
          "legendFormat": "{{tier}}"
        }
      ],
      "description": "App-side admission control only. Since D-035 the fleet-wide ceiling is enforced at nginx, whose limit_req rejections stock nginx cannot export to Prometheus \u2014 those are reported in the demo control panel instead."
    },
    {
      "id": 5,
      "title": "Cache hit rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{result=\"hit\"}[$__rate_interval])) by (cache) / sum(rate(cache_gets_total[$__rate_interval])) by (cache)",
          "legendFormat": "{{cache}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Kafka consumer lag",
      "description": "Total unprocessed messages across all partitions \u00e2\u20ac\u201d how far the fold-consumer is behind the producer. Should climb under a surge and drain back to zero once it passes.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "comment": "records_lag (a plain per-partition gauge), NOT records_lag_max. The _max variant is a windowed statistic that reports NaN once fetches stop returning records; Prometheus drops NaN samples, so the panel kept drawing its last value and showed a large backlog forever after traffic stopped, while the real lag was zero. Summed rather than maxed because the backlog that matters is the total across partitions, not the worst single one.",
          "expr": "sum(kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "total lag"
        }
      ]
    },
    {
      "id": 11,
      "title": "Redis hit rate",
      "description": "Redis's own keyspace hit rate \u00e2\u20ac\u201d the second cache tier, reached only for reads that Caffeine missed, so it reads differently from the local cache panel beside it. Goes flat when Redis is killed, because the circuit breaker stops calling it.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[$__rate_interval]) / (rate(redis_keyspace_hits_total[$__rate_interval]) + rate(redis_keyspace_misses_total[$__rate_interval]))",
          "legendFormat": "redis"
        }
      ]
    },
    {
      "id": 7,
      "title": "App instances up",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(up{job=\"playhead-app\"})",
          "legendFormat": "instances"
        }
      ]
    },
    {
      "id": 8,
      "title": "In-flight write permits used",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(playhead_ingest_inflight_permits)",
          "legendFormat": "in flight",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Local cache misses (total)",
      "description": "Caffeine misses \u00e2\u20ac\u201d the requests that had to go past the in-process cache to Redis or Postgres. Previously mislabelled as a circuit-breaker panel, which it never was: the breaker's state is only logged, not exported as a metric.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(cache_gets_total{result=\"miss\"})",
          "legendFormat": "cache misses (total)"
        }
      ]
    },
    {
      "id": 10,
      "title": "JVM heap used",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "heap"
        }
      ]
    }
  ]
}