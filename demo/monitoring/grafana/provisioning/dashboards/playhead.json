{
  "title": "Playhead — Surge Overview",
  "uid": "playhead-surge",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Read latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=~\"/v1/playback/(resume.*|continue-watching)\"}[$__rate_interval])) by (le, uri))", "legendFormat": "p50 {{uri}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/v1/playback/(resume.*|continue-watching)\"}[$__rate_interval])) by (le, uri))", "legendFormat": "p95 {{uri}}" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=~\"/v1/playback/(resume.*|continue-watching)\"}[$__rate_interval])) by (le, uri))", "legendFormat": "p99 {{uri}}" }
      ]
    },
    {
      "id": 2,
      "title": "Write latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=\"/v1/playback/heartbeat\"}[$__rate_interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/v1/playback/heartbeat\"}[$__rate_interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/v1/playback/heartbeat\"}[$__rate_interval])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "title": "Request rate by status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{status=\"202\"}[$__rate_interval])) or sum(rate(http_server_requests_seconds_count{status=\"200\"}[$__rate_interval]))", "legendFormat": "2xx" },
        { "expr": "sum(rate(http_server_requests_seconds_count{status=\"429\"}[$__rate_interval]))", "legendFormat": "429 shed" },
        { "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx error" }
      ]
    },
    {
      "id": 4,
      "title": "Admission control — shed rate by tier",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(admission_shed_total[$__rate_interval])) by (tier)", "legendFormat": "{{tier}}" }
      ]
    },
    {
      "id": 5,
      "title": "Cache hit rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(cache_gets_total{result=\"hit\"}[$__rate_interval])) by (cache) / sum(rate(cache_gets_total[$__rate_interval])) by (cache)", "legendFormat": "{{cache}}" }
      ]
    },
    {
      "id": 6,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "max(kafka_consumer_fetch_manager_records_lag_max)", "legendFormat": "max lag" }
      ]
    },
    {
      "id": 11,
      "title": "Redis hit rate",
      "description": "Redis's own keyspace hit rate — the second cache tier, reached only for reads that Caffeine missed, so it reads differently from the local cache panel beside it. Goes flat when Redis is killed, because the circuit breaker stops calling it.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[$__rate_interval]) / (rate(redis_keyspace_hits_total[$__rate_interval]) + rate(redis_keyspace_misses_total[$__rate_interval]))",
          "legendFormat": "redis"
        }
      ]
    },
    {
      "id": 7,
      "title": "App instances up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(up{job=\"playhead-app\"})", "legendFormat": "instances" }
      ]
    },
    {
      "id": 8,
      "title": "In-flight write permits used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(admission_admitted_total{tier=\"PLAYBACK_WRITE\"})", "legendFormat": "writes admitted (total)" }
      ]
    },
    {
      "id": 9,
      "title": "Local cache misses (total)",
      "description": "Caffeine misses — the requests that had to go past the in-process cache to Redis or Postgres. Previously mislabelled as a circuit-breaker panel, which it never was: the breaker's state is only logged, not exported as a metric.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(cache_gets_total{result=\"miss\"})", "legendFormat": "cache misses (total)" }
      ]
    },
    {
      "id": 10,
      "title": "JVM heap used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap" }
      ]
    }
  ]
}
